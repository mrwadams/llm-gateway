# LLM Provider API Key
MINIMAX_API_KEY=your-minimax-api-key

# LiteLLM master key (generate a random string)
LITELLM_MASTER_KEY=sk-change-me

# PostgreSQL
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me
POSTGRES_DB=litellm
DATABASE_URL=postgresql://litellm:change-me@postgres:5432/litellm

# Open WebUI
OPENAI_API_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-change-me
DEFAULT_USER_ROLE=pending
ENABLE_SIGNUP=true
ENABLE_OLLAMA_API=false
ENABLE_ADMIN_CHAT_ACCESS=true
ENABLE_ADMIN_EXPORT=true
USER_PERMISSIONS_CHAT_DELETE=false
USER_PERMISSIONS_CHAT_EDIT=false
WEBUI_SECRET_KEY=change-me

# Cloudflare (for Let's Encrypt DNS challenge)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
